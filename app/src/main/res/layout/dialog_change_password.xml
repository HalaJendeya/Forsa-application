<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/desc_change_password_intro"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Current Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/hint_current_password"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/hint_current_password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- New Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/hint_new_password"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/hint_new_password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Confirm New Password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/hint_confirm_new_password"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etConfirmNewPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/hint_confirm_new_password"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Password requirement helper -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/helper_password_rules"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
